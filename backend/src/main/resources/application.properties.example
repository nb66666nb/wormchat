# \u5E94\u7528\u670D\u52A1 WEB \u8BBF\u95EE\u7AEF\u53E3
server.port=6060
ws.port=6061
#WebSocket\u96C6\u7FA4\u5E7F\u64AD\u5F00\u5173\uFF08\u5355\u673A\u90E8\u7F72\u53EF\u7F6Efalse\uFF0C\u8DF3\u8FC7MQ\u76F4\u63A5\u672C\u5730\u63A8\u9001\u964D\u4F4E\u5EF6\u8FDF\uFF09
ws.broadcast.enabled=true
#ACK\u8D85\u65F6\u91CD\u63A8\uFF1A\u9996\u6B21\u5EF6\u8FDF/\u6700\u5927\u91CD\u63A8\u6B21\u6570\uFF08\u6307\u6570\u9000\u907F 3s/6s/12s\uFF09
ws.retry.initial-delay-ms=3000
ws.retry.max-attempts=3
#\u96EA\u82B1\u7B97\u6CD5workerId\uFF080-1023\uFF0C\u96C6\u7FA4\u90E8\u7F72\u5FC5\u987B\u663E\u5F0F\u6307\u5B9A\u4E14\u5404\u8282\u70B9\u4E0D\u540C\uFF1B-1\u8868\u793A\u6309\u4E3B\u673A\u540D+\u7AEF\u53E3\u81EA\u52A8\u63A8\u5BFC\uFF09
snowflake.worker-id=-1
server.servlet.context-path=/api
# Tomcat\u7EBF\u7A0B\u6C60\uFF08\u538B\u6D4B\u8C03\u4F18\uFF1A\u9ED8\u8BA4200\uFF0C\u9AD8\u5E76\u53D1\u4E0BHTTP\u5C42\u6392\u961F\u4F1A\u63A8\u9AD8P95\uFF09
server.tomcat.threads.max=400
server.tomcat.threads.min-spare=50
server.tomcat.accept-count=200
#session\u8FC7\u671F\u65F6\u95F4 60M \u4E00\u4E2A\u5C0F\u65F6
server.servlet.session.timeout=PT60M
#\u5904\u7406favicon
spring.mvc.favicon.enable=false
spring.servlet.multipart.max-file-size=500MB
spring.servlet.multipart.max-request-size=500MB
#\u5206\u7247\u4E0A\u4F20\u9ED8\u8BA4\u5206\u7247\u5927\u5C0F(\u5B57\u8282)\uFF0C\u5EFA\u8BAE 5MB = 5242880
file.chunk.size=5242880
#\u5206\u7247\u4E34\u65F6\u76EE\u5F55\u4FDD\u7559\u5929\u6570\uFF08\u8D85\u8FC7\u540E\u81EA\u52A8\u6E05\u7406\uFF09
file.chunk.ttl.days=7
#\u5355\u7528\u6237\u540C\u65F6\u8FDB\u884C\u4E2D\u7684\u5206\u7247\u4E0A\u4F20\u4EFB\u52A1\u6570\u4E0A\u9650
file.upload.max-concurrent-per-user=5
#\u5355\u6587\u4EF6\u6700\u5927\u5B57\u8282\u6570\uFF08\u9ED8\u8BA4 5GB = 5368709120\uFF09
file.upload.max-file-size=5368709120
#\u9519\u8BEF\u9875\u5904\u7406
spring.mvc.throw-exception-if-no-handler-found=true
spring.web.resources.add-mappings=false
#\u6570\u636E\u5E93\u914D\u7F6E
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/easymetting?serverTimezone=GMT%2B8&useUnicode=true&characterEncoding=utf8&autoReconnect=true&allowMultiQueries=true\
  &useSSL=false
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.hikari.pool-name=HikariCPDatasource
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.idle-timeout=180000
spring.datasource.hikari.maximum-pool-size=80
spring.datasource.hikari.auto-commit=true
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.connection-test-query=SELECT 1
#Spring redis\u914D\u7F6E
# Redis\u6570\u636E\u5E93\u7D22\u5F15\uFF08\u9ED8\u8BA4\u4E3A0\uFF09
spring.redis.database=0
spring.redis.host=127.0.0.1
spring.redis.port=6379
# \u8FDE\u63A5\u6C60\u6700\u5927\u8FDE\u63A5\u6570\uFF08\u4F7F\u7528\u8D1F\u503C\u8868\u793A\u6CA1\u6709\u9650\u5236\uFF09
spring.redis.jedis.pool.max-active=80
# \u8FDE\u63A5\u6C60\u6700\u5927\u963B\u585E\u7B49\u5F85\u65F6\u95F4\uFF08\u4F7F\u7528\u8D1F\u503C\u8868\u793A\u6CA1\u6709\u9650\u5236\uFF09
spring.redis.jedis.pool.max-wait=-1
# \u8FDE\u63A5\u6C60\u4E2D\u7684\u6700\u5927\u7A7A\u95F2\u8FDE\u63A5
spring.redis.jedis.pool.max-idle=20
# \u8FDE\u63A5\u6C60\u4E2D\u7684\u6700\u5C0F\u7A7A\u95F2\u8FDE\u63A5
spring.redis.jedis.pool.min-idle=0
# \u8FDE\u63A5\u8D85\u65F6\u65F6\u95F4\uFF08\u6BEB\u79D2\uFF09
spring.redis.timeout=2000
# redis\u914D\u7F6E\u7ED3\u675F
#rabbitmq\u914D\u7F6E
spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest
spring.rabbitmq.virtual-host=/
spring.rabbitmq.publisher-confirm-type=correlated
spring.rabbitmq.publisher-returns=true
spring.rabbitmq.listener.simple.concurrency=5
spring.rabbitmq.listener.simple.max-concurrency=10
spring.rabbitmq.listener.simple.prefetch=1
#\u6D88\u606F\u5904\u7406\u901A\u9053\uFF1Aredis\u6216rabbitmq\uFF08\u7528\u4E8EIM\u6D88\u606F\u8F6C\u53D1\uFF09
messaging.handle.channel=redis
#\u9879\u76EE\u76EE\u5F55
project.folder=D:/meetchat-Localfiles
#\u65E5\u5FD7\u7EA7\u522B\u914D\u7F6E
log.root.level=debug
#\u8D85\u7EA7\u7BA1\u7406\u5458id
admin.emails=admin@qq.com


#ai\u914D\u7F6E
ai.llm.api-key=YOUR_DASHSCOPE_API_KEY
ai.llm.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
ai.llm.model=qwen3.6-plus
ai.llm.max-tokens=1024
ai.llm.temperature=0.8
ai.rag.enabled=true
ai.mcp.enabled=true
ai.llm.timeout-seconds=60
ai.agent.max-iterations=5

# ==================== RAG\u6DF7\u5408\u68C0\u7D22\u914D\u7F6E ====================
# \u5411\u91CF\u68C0\u7D22\u5F00\u5173
rag.vector.enabled=true
# \u5173\u952E\u8BCD\u68C0\u7D22\u5F00\u5173
rag.keyword.enabled=true
# Milvus\u914D\u7F6E
rag.milvus.host=localhost
rag.milvus.port=19530
rag.milvus.collection-name=rag_documents

# ==================== AI\u9650\u6D41\u914D\u7F6E ====================
# \u7528\u6237\u6D88\u606F\u9891\u7387\u9650\u5236\uFF08\u6761/\u5206\u949F\uFF09
ratelimit.user.message-per-minute=20
# Agent\u5E76\u53D1\u6267\u884C\u9650\u5236\uFF08\u540C\u4E00\u673A\u5668\u4EBA\u540C\u65F6\u5904\u7406\u7684\u8BF7\u6C42\u6570\uFF09
ratelimit.agent.concurrent=10
# LLM API\u5168\u5C40QPS\u9650\u5236
ratelimit.llm.qps=50
# \u7528\u6237\u753B\u50CF\u66F4\u65B0\u51B7\u5374\u65F6\u95F4\uFF08\u79D2\uFF09
ratelimit.profile.cooldown-seconds=60