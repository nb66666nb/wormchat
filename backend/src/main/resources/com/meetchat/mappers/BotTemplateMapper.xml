			</if>
			<if test="query.responseStyleFuzzy!= null  and query.responseStyleFuzzy!=''">
				 and  b.response_style like concat('%', #{query.responseStyleFuzzy}, '%')
			</if>
			<if test="query.emojiFrequencyFuzzy!= null  and query.emojiFrequencyFuzzy!=''">
				 and  b.emoji_frequency like concat('%', #{query.emojiFrequencyFuzzy}, '%')
			</if>
			<if test="query.enabledToolsFuzzy!= null  and query.enabledToolsFuzzy!=''">
				 and  b.enabled_tools like concat('%', #{query.enabledToolsFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  b.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  b.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  b.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  b.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

