	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.templateIdFuzzy!= null  and query.templateIdFuzzy!=''">
				 and  b.template_id like concat('%', #{query.templateIdFuzzy}, '%')
			</if>
			<if test="query.templateNameFuzzy!= null  and query.templateNameFuzzy!=''">
				 and  b.template_name like concat('%', #{query.templateNameFuzzy}, '%')
			</if>
			<if test="query.templateCategoryFuzzy!= null  and query.templateCategoryFuzzy!=''">
				 and  b.template_category like concat('%', #{query.templateCategoryFuzzy}, '%')
			</if>
			<if test="query.defaultAvatarPathFuzzy!= null  and query.defaultAvatarPathFuzzy!=''">
				 and  b.default_avatar_path like concat('%', #{query.defaultAvatarPathFuzzy}, '%')
			</if>
			<if test="query.defaultSystemPromptFuzzy!= null  and query.defaultSystemPromptFuzzy!=''">
				 and  b.default_system_prompt like concat('%', #{query.defaultSystemPromptFuzzy}, '%')
			</if>
			<if test="query.defaultWelcomeMsgFuzzy!= null  and query.defaultWelcomeMsgFuzzy!=''">
